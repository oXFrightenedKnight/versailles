{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    "rootDir": "../../",
    "outDir": "dist",

    "declaration": true,
    "emitDeclarationOnly": true,

    "strict": true,
    "skipLibCheck": true,

    "types": ["node"],

    "moduleDetection": "force"
  },
  "include": ["src", "drizzle.config.ts"],
  "exclude": ["node_modules"],
  "extends": "../../tsconfig.base.json"
}
